# Your Discord bot token (you already have this)
DISCORD_TOKEN=dc_bot_token

# Your voice channel ID (you already have this)
VOICE_CHANNEL_ID=Voice_channel_id

# Gmail SMTP settings (these are correct for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your Gmail address
SMTP_USER=youremail@gmail.com

# The 16-character app password from step 2
SMTP_PASS=app_pass

# Who the email is from (your Gmail)
EMAIL_FROM=youremail@gmail.com

# Who receives the meeting reports (comma-separated for multiple recipients)
EMAIL_TO=youremail@gmail.com,anotheremail@example.com

# How long to wait before ending meeting (5 minutes)
MEETING_END_TIMEOUT=300
